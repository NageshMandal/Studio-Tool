<%
  /**
   * The master dashboard: everything across every studio, on one screen.
   *
   * Almost every number here is a door. Rather than making the super admin
   * navigate away and lose their place, clicking a card or a list opens a
   * panel on the right with the detail behind it — see public/js/app.js.
   * Each opener carries `data-panel` (which panel) and `data-title` (what to
   * call it); the panel's contents are fetched, not pre-rendered, so the
   * page stays light no matter how much is behind it.
   */
%>

<section class="hello">
  <div>
    <h2><%= greeting %>, <%= admin.name %> 👋</h2>
    <p class="sub">Here's your complete studio management overview</p>
  </div>
</section>

<%
  /* The filter bar drives the movement lists lower down. It deliberately
     does not touch the cards: those count how things stand right now, and
     re-reading "36 items" as "36 items this week" would make two true
     numbers look like they disagree. */
%>
<form class="panel filters filters-lead" method="GET" action="/admin/master">
  <%- include('partials/date-range', { range: range, presets: ['today', '7d', '30d', 'month', 'all'], maxDate: maxDate }) %>

  <%
    /**
     * Free-text search, across every field a person might have in mind.
     *
     * It sits above the dropdowns because it is usually the faster way in:
     * the item list runs to dozens of entries, and typing "cemera" beats
     * scrolling to find it. The dropdowns pin an exact record; this finds
     * one when you only half remember it.
     */
  %>
  <label class="field field-wide">
    <span>Search anything</span>
    <input type="search" name="q" value="<%= query.q %>" autocomplete="off"
           placeholder="Item, asset tag, person, studio or reason — e.g. PAT-0004, mic, Ritu" />
  </label>

  <label class="field">
    <span>Studio</span>
    <select name="studio">
      <option value="">All studios</option>
      <% studios.forEach(function (s) { %>
        <option value="<%= s._id %>" <%= query.studio === String(s._id) ? 'selected' : '' %>><%= s.name %></option>
      <% }); %>
    </select>
  </label>

  <label class="field">
    <span>Item / asset</span>
    <select name="product">
      <option value="">All items</option>
      <% itemList.forEach(function (i) { %>
        <option value="<%= i._id %>" <%= query.product === String(i._id) ? 'selected' : '' %>>
          <%= i.name %> (<%= i.assetTag %>)
        </option>
      <% }); %>
    </select>
  </label>

  <label class="field">
    <span>Employee</span>
    <select name="staff">
      <option value="">All employees</option>
      <% staffList.forEach(function (u) { %>
        <option value="<%= u._id %>" <%= query.staff === String(u._id) ? 'selected' : '' %>><%= u.name %></option>
      <% }); %>
    </select>
  </label>

  <label class="field">
    <span>Transaction</span>
    <select name="type">
      <option value="">All (issue / return)</option>
      <option value="issue" <%= query.type === 'issue' ? 'selected' : '' %>>Occupied</option>
      <option value="return" <%= query.type === 'return' ? 'selected' : '' %>>Returned</option>
    </select>
  </label>

  <div class="actions">
    <button class="btn btn-primary" type="submit"><%- icon('search', 15) %> Search</button>
    <a class="btn btn-ghost" href="/admin/master">Clear</a>
  </div>
</form>

<%
  /* The cards. Each one opens the list behind it, because a number on its
     own only ever prompts the question "which ones?" */
%>
<section class="stat-grid stat-grid-6">
  <button class="stat is-openable tone-blue" type="button"
          data-panel="studios" data-title="Studios">
    <div class="stat-head">
      <div>
        <span class="stat-label">Total studios</span>
        <div class="stat-value"><%= totals.studioCount %></div>
      </div>
      <span class="stat-ico" style="background: var(--blue-soft); color: var(--blue)"><%- icon('building', 18) %></span>
    </div>
    <p class="stat-note"><%= studios.map(function (s) { return s.name; }).join(', ') || 'None yet' %></p>
  </button>

  <button class="stat is-openable" type="button" data-panel="items" data-title="All items">
    <div class="stat-head">
      <div>
        <span class="stat-label">Total items</span>
        <div class="stat-value"><%= totals.totalItems %></div>
      </div>
      <span class="stat-ico" style="background: var(--purple-soft); color: var(--purple)"><%- icon('box', 18) %></span>
    </div>
    <p class="stat-note">
      <% if (totals.addedThisMonth) { %>
        <span class="up">↑ +<%= totals.addedThisMonth %> this month</span>
      <% } else { %>
        Across every studio
      <% } %>
    </p>
  </button>

  <button class="stat is-openable" type="button" data-panel="employees" data-title="Employees">
    <div class="stat-head">
      <div>
        <span class="stat-label">Employees / staff</span>
        <div class="stat-value"><%= totals.staffCount %></div>
      </div>
      <span class="stat-ico" style="background: var(--green-soft); color: var(--green)"><%- icon('people', 18) %></span>
    </div>
    <p class="stat-note">Active staff</p>
  </button>

  <button class="stat is-openable" type="button" data-panel="out"
          data-title="Items currently out"
          data-params="<%= totals.overdueItems > 0 ? 'late=yes' : '' %>">
    <div class="stat-head">
      <div>
        <span class="stat-label">Items currently out</span>
        <div class="stat-value"><%= totals.outNow %></div>
      </div>
      <span class="stat-ico" style="background: var(--amber-soft); color: var(--amber)"><%- icon('arrow', 18) %></span>
    </div>
    <p class="stat-note">
      <%= totals.outPct %>% of the register<% if (totals.overdueItems > 0) { %>
        · <span class="danger"><%= totals.overdueItems %> overdue</span>
      <% } %>
    </p>
  </button>

  <button class="stat is-openable" type="button" data-panel="pending" data-title="Pending requests">
    <div class="stat-head">
      <div>
        <span class="stat-label">Pending requests</span>
        <div class="stat-value"><%= totals.pendingTotal %></div>
      </div>
      <span class="stat-ico" style="background: var(--teal-soft); color: var(--teal)"><%- icon('inbox', 18) %></span>
    </div>
    <p class="stat-note">Awaiting approval</p>
  </button>

  <%
    /**
     * A zero here is almost always "no prices have been entered", not "the
     * equipment is worthless" — so the card says which. A bare ₹0 under
     * "Estimated value" reads as broken software and sends people looking
     * for a bug that is not there.
     */
  %>
  <button class="stat is-openable" type="button" data-panel="value"
          data-title="Asset value"
          data-params="<%= totals.pricedItems === 0 ? 'priced=no' : '' %>">
    <div class="stat-head">
      <div>
        <span class="stat-label">Total asset value</span>
        <div class="stat-value"><%= formatMoney(totals.totalValue) %></div>
      </div>
      <span class="stat-ico" style="background: var(--blue-soft); color: var(--blue)"><%- icon('report', 18) %></span>
    </div>
    <p class="stat-note">
      <% if (totals.totalItems === 0) { %>
        No items on the register yet
      <% } else if (totals.pricedItems === 0) { %>
        <span class="warn">No prices recorded yet — open to add them</span>
      <% } else if (totals.unpricedItems > 0) { %>
        From <%= totals.pricedItems %> of <%= totals.totalItems %> items ·
        <span class="warn"><%= totals.unpricedItems %> unpriced</span>
      <% } else { %>
        All <%= totals.totalItems %> items priced
      <% } %>
    </p>
  </button>
</section>

<div class="master-grid">
  <div class="master-main">
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2><%- icon('box', 17) %> Recent issued items</h2>
          <p class="sub">
            Latest items issued to employees · <%= range.label %><%= query.q ? ' · matching “' + query.q + '”' : '' %>
          </p>
        </div>
        <button class="btn btn-ghost btn-sm" type="button"
                data-panel="issued" data-title="Issued items"
                data-params="<%= 'from=' + (range.from || '') + '&to=' + (range.to || '') + '&studio=' + query.studio + '&staff=' + query.staff + '&product=' + query.product + '&type=' + query.type + '&q=' + encodeURIComponent(query.q) %>">
          View all
        </button>
      </div>

      <% if (issued.length === 0) { %>
        <div class="empty">
          <h3>Nothing in <%= range.label %></h3>
          <p>
            No equipment movements matched<%= query.q ? ' “' + query.q + '”' : ' those filters' %>.
            <% if (query.q) { %>Try a shorter search, or clear it.<% } %>
          </p>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>#</th><th>Taken</th><th>Employee</th><th>Studio</th>
                <th>Item (asset)</th><th>Submitted</th><th>Accepted</th><th>Duration</th><th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% issued.forEach(function (r, n) { %>
                <tr class="is-clickable" data-panel="item" data-params="id=<%= r.product %>" data-title="<%= r.productName %>">
                  <td><%= n + 1 %></td>
                  <td><%= formatWhen(r.occupiedAt) %></td>
                  <td><%= r.userName %></td>
                  <td><%= r.locationName || '—' %></td>
                  <td>
                    <span class="row-title"><%= r.productName %></span>
                    <span class="row-sub"><%= r.assetTag %></span>
                  </td>
                  <%- include('partials/return-cells', { log: r }) %>
                  <td><%= r.durationMinutes != null ? formatDuration(r.durationMinutes) : formatSince(r.occupiedAt) %></td>
                  <td>
                    <% if (r.returnedAt) { %>
                      <span class="badge badge-green">Returned</span>
                    <% } else if (r.submittedAt) { %>
                      <span class="badge badge-purple">Awaiting approval</span>
                    <% } else { %>
                      <span class="badge badge-blue">Occupied</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="panel-foot">
          <p class="hint"><%= issuedTotal %> movement<%= issuedTotal === 1 ? '' : 's' %> in <%= range.label %>.</p>
        </div>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2><%- icon('clock', 17) %> Recent activity</h2>
        <button class="btn btn-ghost btn-sm" type="button" data-panel="activity" data-title="Activity">View all</button>
      </div>
      <div class="panel-body">
        <% if (activity.length === 0) { %>
          <p class="panel-empty">Nothing has happened yet.</p>
        <% } else { %>
          <ul class="activity-list">
            <% activity.forEach(function (e) { %>
              <li>
                <span class="dot dot-<%= e.tone %>"></span>
                <span class="activity-text">
                  <b><%= e.who %></b> <%= e.verb %> <b><%= e.what %></b><%= e.where ? ' at ' + e.where : '' %>
                </span>
                <span class="activity-when"><%= formatSince(e.at) %> ago</span>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </section>
  </div>

  <aside class="master-side">
    <section class="panel">
      <div class="panel-head">
        <h2><%- icon('building', 17) %> Top studios</h2>
        <button class="btn btn-ghost btn-sm" type="button" data-panel="studios" data-title="Studios">View all</button>
      </div>
      <ul class="mini-list">
        <% studioRanking.slice(0, 5).forEach(function (s) { %>
          <li class="theme-<%= s.theme %>" data-panel="items"
              data-params="studio=<%= s._id %>" data-title="Items at <%= s.name %>">
            <span class="mini-mark"><%- icon('building', 15) %></span>
            <span class="mini-name"><%= s.name %></span>
            <span class="mini-value"><b><%= s.itemCount %></b> items</span>
            <span class="mini-go"><%- icon('arrow', 14) %></span>
          </li>
        <% }); %>
      </ul>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2><%- icon('box', 17) %> Item categories</h2>
        <button class="btn btn-ghost btn-sm" type="button" data-panel="categories" data-title="Categories">View all</button>
      </div>
      <ul class="mini-list">
        <% categories.slice(0, 6).forEach(function (c) { %>
          <li data-panel="items"
              data-params="category=<%= encodeURIComponent(c.category) %>"
              data-title="<%= c.category %> items">
            <span class="mini-mark"><%- icon('box', 15) %></span>
            <span class="mini-name"><%= c.category %></span>
            <span class="mini-value"><b><%= c.total %></b> <span class="hint"><%= c.pct %>%</span></span>
            <span class="mini-go"><%- icon('arrow', 14) %></span>
          </li>
        <% }); %>
        <% if (categories.length === 0) { %>
          <li><span class="mini-name hint">No items yet</span></li>
        <% } %>
      </ul>
    </section>
  </aside>
</div>

<div class="alert alert-info">
  <b>Note.</b> Purchase requests raised by staff are handled by each studio's own
  admin and are not shown here — they are private to the studio that raised them.
</div>

<%
  /* The panel itself. One element, reused: its contents are fetched each
     time it opens, so nothing here is rendered until it is actually asked
     for, and there is no second copy of the data sitting in the page. */
%>
<div class="drawer-backdrop" id="drawerBackdrop" hidden></div>
<aside class="drawer" id="drawer" aria-hidden="true" aria-labelledby="drawerTitle">
  <header class="drawer-head">
    <div>
      <h2 id="drawerTitle">Details</h2>
      <button class="drawer-back" type="button" id="drawerBack" hidden>‹ Back</button>
    </div>
    <button class="drawer-close" type="button" id="drawerClose" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </header>
  <div class="drawer-body" id="drawerBody"></div>
</aside>
