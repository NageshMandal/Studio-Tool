<%
  /**
   * One request card. Declared once and called from both the batch groups
   * and the ungrouped list, so an item asked for as part of five looks and
   * behaves exactly like one asked for on its own — including its own
   * Approve and Decline, which is what makes a partial decision possible.
   */
  function requestCard(r) {
%>
  <div class="request-card">
    <div class="request-head">
      <div>
        <h3><%= r.productName %></h3>
        <div class="request-meta">
          <span class="asset-tag"><%= r.assetTag %></span>
          <span><%- icon('user', 13) %> <%= r.userName %></span>
          <span><%= formatWhen(r.createdAt) %></span>
        </div>
      </div>
    </div>

    <% if (r.reason) { %><p class="request-body"><%= r.reason %></p><% } %>

    <% if (r.productGone) { %>
      <div class="alert alert-error" style="margin: 12px 0 0">That item is no longer on the register.</div>
    <% } else if (r.productBusy) { %>
      <div class="alert alert-warn" style="margin: 12px 0 0">Somebody else already has this item.</div>
    <% } else if (r.productBlocked) { %>
      <div class="alert alert-warn" style="margin: 12px 0 0">This item is in maintenance or retired.</div>
    <% } %>

    <div class="request-actions">
      <form method="POST" action="/admin/requests/<%= r._id %>/approve">
        <button class="btn btn-ok btn-sm" type="submit"><%- icon('check', 14) %> Approve</button>
      </form>
      <form method="POST" action="/admin/requests/<%= r._id %>/reject" data-note="Reason for declining (optional):">
        <input type="hidden" name="note" />
        <button class="btn btn-danger btn-sm" type="submit">Decline</button>
      </form>
    </div>
  </div>
<%
  }
%>

<section class="panel">
  <div class="panel-head">
    <div>
      <h2>Submissions to accept</h2>
      <p class="sub">Staff asking to hand an item back — it stays with them until you accept</p>
    </div>
    <span class="badge <%= submitted.length ? 'badge-amber' : 'badge-green' %>">
      <%= submitted.length %> waiting
    </span>
  </div>

  <div class="panel-body">
    <% if (submitted.length === 0) { %>
      <div class="empty"><p>No submissions are waiting.</p></div>
    <% } else { %>
      <p class="hint" style="margin-bottom: 12px">
        Each of these is still signed out to the person who submitted it, and
        still counted as out, until you accept it. Accepting is what puts it
        back on the shelf and hands it to anyone waiting.
      </p>

      <% submitted.forEach(function (l) { %>
        <div class="request-card">
          <div class="request-head">
            <div>
              <h3><%= l.productName %></h3>
              <div class="request-meta">
                <span class="asset-tag"><%= l.assetTag %></span>
                <span><%- icon('user', 13) %> <%= l.userName %></span>
                <span>Submitted <%= formatWhen(l.submittedAt) %></span>
                <span>Held <%= formatSince(l.occupiedAt) %> so far</span>
              </div>
            </div>
            <span class="badge badge-purple">Still with <%= l.userName %></span>
          </div>

          <p class="request-body">
            <b>Their remark:</b> <%= l.submitRemark || 'None given' %>
          </p>

          <form method="POST" action="/admin/returns/<%= l._id %>/accept" class="checkin-form">
            <label class="field">
              <span>Your remark</span>
              <input type="text" name="remark" maxlength="300" required
                     placeholder="NA if it came back fine" />
              <span class="help">
                Both remarks stay on this movement, so if something happened to
                the item there are two accounts of it with times against them.
              </span>
            </label>

            <label class="field">
              <span>Condition</span>
              <select name="condition">
                <option value="">Leave as it is</option>
                <option value="good">Good</option>
                <option value="new">As new</option>
                <option value="needs-repair">Needs repair</option>
                <option value="retired">Retire it</option>
              </select>
              <span class="help">Marking it for repair sends it to maintenance instead of the shelf.</span>
            </label>

            <div class="actions">
              <button class="btn btn-ok btn-sm" type="submit"><%- icon('check', 14) %> Accept</button>
            </div>
          </form>

          <%
            /* Sending it back is the escape hatch for a submission made by
               mistake, or an item that never actually turned up. Without it
               the only ways out are accepting something you never received,
               or leaving it in the queue forever. */
          %>
          <form method="POST" action="/admin/returns/<%= l._id %>/decline" class="btn-row"
                style="margin-top: 10px" data-note="Why are you sending this back to them?">
            <input type="hidden" name="remark" />
            <button class="btn btn-ghost btn-sm" type="submit">Send back — it never arrived</button>
          </form>
        </div>
      <% }); %>
    <% } %>
  </div>
</section>

<section class="panel">
  <div class="panel-head">
    <div>
      <h2>Equipment requests</h2>
      <p class="sub">People at <%= activeStudio.name %> asking to take something out now</p>
    </div>
    <span class="badge <%= pending.length ? 'badge-amber' : 'badge-green' %>">
      <%= pending.length %> waiting
    </span>
  </div>

  <div class="panel-body">
    <% if (pending.length === 0) { %>
      <div class="empty"><p>No equipment requests are waiting.</p></div>
    <% } else { %>

      <%
        /* Batches first: somebody asking for a camera, a lens and a tripod
           for one shoot is one decision most of the time, and five separate
           cards would hide that they belong together. */
      %>
      <% batches.forEach(function (b) { %>
        <div class="batch">
          <div class="batch-head">
            <div>
              <h3><%= b.userName %> asked for <%= b.items.length %> items together</h3>
              <p class="hint">
                <%= formatWhen(b.createdAt) %><%= b.reason ? ' · ' + b.reason : '' %>
              </p>
            </div>
            <div class="btn-row">
              <form method="POST" action="/admin/requests/batch/<%= b.batch %>/approve">
                <button class="btn btn-ok btn-sm" type="submit">
                  <%- icon('check', 14) %> Approve all <%= b.items.length %>
                </button>
              </form>
              <form method="POST" action="/admin/requests/batch/<%= b.batch %>/reject"
                    data-note="Reason for declining all of them (optional):">
                <input type="hidden" name="note" />
                <button class="btn btn-danger btn-sm" type="submit">Decline all</button>
              </form>
            </div>
          </div>

          <p class="hint batch-note">
            Or decide them one at a time — approving some and declining the
            rest is fine, and the batch simply shrinks.
          </p>

          <% b.items.forEach(function (r) { requestCard(r); }); %>
        </div>
      <% }); %>

      <% loose.forEach(function (r) { requestCard(r); }); %>
    <% } %>
  </div>
</section>

<section class="panel">
  <div class="panel-head">
    <div>
      <h2>Bookings to confirm</h2>
      <p class="sub">Advance reservations waiting on you</p>
    </div>
    <span class="badge <%= pendingBookings.length ? 'badge-amber' : 'badge-green' %>">
      <%= pendingBookings.length %> waiting
    </span>
  </div>

  <div class="panel-body">
    <% if (pendingBookings.length === 0) { %>
      <div class="empty"><p>No bookings are waiting.</p></div>
    <% } else { %>
      <% pendingBookings.forEach(function (b) { %>
        <div class="request-card">
          <div class="request-head">
            <div>
              <h3><%= b.productName %></h3>
              <div class="request-meta">
                <span class="asset-tag"><%= b.assetTag %></span>
                <span><%= b.userName %></span>
                <span><%= formatDay(b.bookedFor) %><%= b.pickupTime ? ' ' + b.pickupTime : '' %></span>
              </div>
            </div>
          </div>

          <% if (b.reason) { %><p class="request-body"><%= b.reason %></p><% } %>

          <% if (b.awaitingReturn) { %>
            <div class="alert alert-info" style="margin: 12px 0 0">
              The item is still out. The holder has been asked to submit it.
            </div>
          <% } %>
          <% if (b.dayTaken) { %>
            <div class="alert alert-warn" style="margin: 12px 0 0">That day is already confirmed for someone else.</div>
          <% } %>
          <% if (b.dayPassed) { %>
            <div class="alert alert-warn" style="margin: 12px 0 0">That day has already passed.</div>
          <% } %>

          <div class="request-actions">
            <form method="POST" action="/admin/requests/bookings/<%= b._id %>/approve">
              <button class="btn btn-ok btn-sm" type="submit">Confirm</button>
            </form>
            <form method="POST" action="/admin/requests/bookings/<%= b._id %>/reject"
                  onsubmit="var n = prompt('Reason for declining (optional):'); if (n === null) return false; this.note.value = n; return true;">
              <input type="hidden" name="note" />
              <button class="btn btn-danger btn-sm" type="submit">Decline</button>
            </form>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</section>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px">
  <section class="panel">
    <div class="panel-head"><h2>Upcoming confirmed bookings</h2></div>
    <div class="table-wrap">
      <% if (upcomingBookings.length === 0) { %>
        <div class="empty"><p>Nothing booked ahead.</p></div>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Item</th><th>Person</th><th>Day</th><th></th></tr></thead>
          <tbody>
            <% upcomingBookings.forEach(function (b) { %>
              <tr>
                <td><span class="row-title"><%= b.productName %></span><span class="row-sub"><%= b.assetTag %></span></td>
                <td><%= b.userName %></td>
                <td><%= formatDay(b.bookedFor) %></td>
                <td>
                  <form method="POST" action="/admin/requests/bookings/<%= b._id %>/cancel"
                        onsubmit="return confirm('Cancel this confirmed booking?')">
                    <button class="btn btn-ghost btn-sm" type="submit">Cancel</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <div>
        <h2>Next in line</h2>
        <p class="sub">Holders decide these, not you — shown for awareness</p>
      </div>
    </div>
    <div class="table-wrap">
      <% if (waitingClaims.length === 0) { %>
        <div class="empty"><p>Nobody is queueing.</p></div>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Item</th><th>Waiting</th><th>Held by</th></tr></thead>
          <tbody>
            <% waitingClaims.forEach(function (c) { %>
              <tr>
                <td><span class="row-title"><%= c.productName %></span></td>
                <td><%= c.userName %></td>
                <td><%= c.holderName || '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </section>
</div>

<% if (decided.length) { %>
  <section class="panel">
    <div class="panel-head"><h2>Recently decided</h2></div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Item</th><th>Person</th><th>Outcome</th><th>By</th><th>When</th></tr></thead>
        <tbody>
          <% decided.forEach(function (r) { %>
            <tr>
              <td><span class="row-title"><%= r.productName %></span><span class="row-sub"><%= r.assetTag %></span></td>
              <td><%= r.userName %></td>
              <td>
                <span class="badge <%= r.status === 'approved' ? 'badge-green' : 'badge-grey' %>"><%= r.status %></span>
                <% if (r.decisionNote) { %><span class="row-sub"><%= r.decisionNote %></span><% } %>
              </td>
              <td><%= r.decidedBy || '—' %></td>
              <td><%= formatWhen(r.decidedAt) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>
