
<section class="stat-grid">
  <div class="stat tone-blue">
    <div class="stat-head">
      <div>
        <span class="stat-label">Total items</span>
        <div class="stat-value"><%= stats.totalItems %></div>
      </div>
      <span class="stat-ico"><%- icon('box', 18) %></span>
    </div>
    <p class="stat-note"><%= formatMoney(stats.totalValue) %> on the register</p>
  </div>

  <div class="stat tone-green">
    <div class="stat-head">
      <div>
        <span class="stat-label">Available</span>
        <div class="stat-value"><%= stats.availableItems %></div>
      </div>
      <span class="stat-ico"><%- icon('check', 18) %></span>
    </div>
    <span class="stat-pct"><%= stats.availablePct %>%</span>
  </div>

  <div class="stat tone-amber">
    <div class="stat-head">
      <div>
        <span class="stat-label">Out with staff</span>
        <div class="stat-value"><%= stats.assignedItems %></div>
      </div>
      <span class="stat-ico"><%- icon('clock', 18) %></span>
    </div>
    <span class="stat-pct"><%= stats.assignedPct %>%</span>
  </div>

  <div class="stat tone-red">
    <div class="stat-head">
      <div>
        <span class="stat-label">Pending approval</span>
        <div class="stat-value"><%= stats.pendingTotal %></div>
      </div>
      <span class="stat-ico"><%- icon('alert', 18) %></span>
    </div>
    <p class="stat-note"><%= stats.pendingRequests %> requests · <%= stats.pendingBookings %> bookings</p>
  </div>
</section>

<%
  // A short line of things actually waiting on this admin right now. It is
  // only rendered when there is something to say, so an all-clear day stays
  // quiet rather than showing a row of zeroes.
  var todo = [];
  if (stats.pendingTotal > 0) {
    todo.push({ href: '/admin/requests', label: stats.pendingTotal + ' equipment request' + (stats.pendingTotal === 1 ? '' : 's') + ' to decide' });
  }
  if (can.viewProcurement && openProcurement > 0) {
    todo.push({ href: '/admin/purchase-requests', label: openProcurement + ' purchase request' + (openProcurement === 1 ? '' : 's') + ' from staff' });
  }
  if (stats.maintenanceItems > 0) {
    todo.push({ href: '/admin/products?status=maintenance', label: stats.maintenanceItems + ' item' + (stats.maintenanceItems === 1 ? '' : 's') + ' in maintenance' });
  }
%>
<% if (todo.length) { %>
  <div class="alert alert-warn" style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center">
    <b>Waiting on you:</b>
    <% todo.forEach(function (t, i) { %>
      <a href="<%= t.href %>" style="text-decoration: underline; font-weight: 600"><%= t.label %></a>
    <% }); %>
  </div>
<% } %>

<section class="panel">
  <div class="panel-head">
    <div>
      <h2>Studio tracker</h2>
      <p class="sub">What is out right now at <%= studio.name %></p>
    </div>
    <div class="btn-row">
      <a class="btn btn-ghost btn-sm" href="/admin/tracker">Full tracker</a>
      <a class="btn btn-primary btn-sm" href="/admin/products/new"><%- icon('plus', 15) %> Add item</a>
    </div>
  </div>

  <% if (outNow.length === 0) { %>
    <div class="empty">
      <h3>Everything is on the shelf</h3>
      <p>Nothing is signed out at the moment.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th></th>
            <th>Asset tag</th>
            <th>Item</th>
            <th>Assigned to</th>
            <th>Taken for</th>
            <th>Since</th>
            <th>Held</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% outNow.forEach(function (item) { %>
            <tr>
              <td class="thumb-cell">
                <%- include('partials/thumb', { thumbUrl: item.imageUrl, thumbName: item.name }) %>
              </td>
              <td><span class="asset-tag"><%= item.assetTag %></span></td>
              <td>
                <a class="row-title" href="/admin/products/<%= item._id %>/edit"><%= item.name %></a>
                <span class="row-sub"><%= item.brand || '' %> <%= item.model || '' %></span>
              </td>
              <td>
                <% if (item.assignedTo) { %>
                  <span class="person">
                    <span class="avatar"><%= item.assignedTo.name.trim().charAt(0).toUpperCase() %></span>
                    <%= item.assignedTo.name %>
                  </span>
                <% } else { %>—<% } %>
              </td>
              <td><%= item.occupyReason || '—' %></td>
              <td><%= formatWhen(item.occupiedAt) %></td>
              <td><span class="badge badge-amber"><%= formatSince(item.occupiedAt) %></span></td>
              <td><a class="btn btn-ghost btn-sm" href="/admin/products/<%= item._id %>/edit">View</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 20px">
  <section class="panel">
    <div class="panel-head">
      <div>
        <h2>Today's movements</h2>
        <p class="sub"><%= stats.takenToday %> taken · <%= stats.returnedToday %> returned</p>
      </div>
      <a class="btn btn-ghost btn-sm" href="/admin/logs">Full log</a>
    </div>

    <% if (todayLogs.length === 0) { %>
      <div class="empty"><p>No movements logged today yet.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Item</th><th>Person</th><th>Taken</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% todayLogs.forEach(function (l) { %>
              <tr>
                <td>
                  <span class="row-title"><%= l.productName %></span>
                  <span class="row-sub"><%= l.assetTag %></span>
                </td>
                <td><%= l.userName %></td>
                <td><%= formatTime(l.occupiedAt) %></td>
                <td>
                  <% if (l.returnedAt) { %>
                    <span class="badge badge-green">Returned</span>
                  <% } else { %>
                    <span class="badge badge-amber">Out</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="panel">
    <div class="panel-head">
      <div>
        <h2>Recently added</h2>
        <p class="sub">Newest items on this studio's register</p>
      </div>
      <a class="btn btn-ghost btn-sm" href="/admin/products">All items</a>
    </div>

    <% if (recent.length === 0) { %>
      <div class="empty">
        <h3>Nothing logged yet</h3>
        <p>Add the first item to start <%= studio.name %>'s register.</p>
        <a class="btn btn-primary" href="/admin/products/new">Add item</a>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th></th><th>Item</th><th>Category</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% recent.forEach(function (item) { %>
              <tr>
                <td class="thumb-cell">
                  <%- include('partials/thumb', { thumbUrl: item.imageUrl, thumbName: item.name }) %>
                </td>
                <td>
                  <a class="row-title" href="/admin/products/<%= item._id %>/edit"><%= item.name %></a>
                  <span class="row-sub"><%= item.assetTag %></span>
                </td>
                <td><%= item.category %></td>
                <td>
                  <% if (item.assignedTo) { %>
                    <span class="badge badge-amber">With <%= item.assignedTo.name.split(' ')[0] %></span>
                  <% } else if (item.status === 'maintenance') { %>
                    <span class="badge badge-red">Maintenance</span>
                  <% } else { %>
                    <span class="badge badge-green">Available</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>
