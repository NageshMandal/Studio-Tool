
<section class="panel" style="max-width: 900px">
  <div class="panel-head">
    <div>
      <h2><%= isEdit ? 'Edit item' : 'New item' %></h2>
      <p class="sub">
        <%= isEdit ? product.assetTag : 'It will be tagged ' + studio.code + '-nnnn and belong to ' + studio.name %>
      </p>
    </div>
  </div>

  <div class="panel-body">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof message !== 'undefined' && message) { %><div class="alert alert-success"><%= message %></div><% } %>

    <form method="POST" action="<%= formAction %>" novalidate>
      <div class="form-grid">
        <label class="field">
          <span>Item name</span>
          <input type="text" name="name" value="<%= product.name || '' %>" required autofocus />
        </label>

        <label class="field">
          <span>Category</span>
          <select name="category">
            <% categories.forEach(function (c) { %>
              <option value="<%= c %>" <%= product.category === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </label>

        <label class="field">
          <span>Brand</span>
          <input type="text" name="brand" value="<%= product.brand || '' %>" />
        </label>

        <label class="field">
          <span>Model</span>
          <input type="text" name="model" value="<%= product.model || '' %>" />
        </label>

        <label class="field">
          <span>Serial number</span>
          <input type="text" name="serialNumber" value="<%= product.serialNumber || '' %>" />
        </label>

        <label class="field">
          <span>Where it is kept</span>
          <input type="text" name="storageArea" value="<%= product.storageArea || 'Main store' %>"
                 placeholder="Shelf, rack or cupboard" />
        </label>

        <label class="field">
          <span>Condition</span>
          <select name="condition">
            <% conditions.forEach(function (c) { %>
              <option value="<%= c %>" <%= product.condition === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </label>

        <label class="field">
          <span>Status</span>
          <select name="status">
            <% statuses.forEach(function (s) { %>
              <option value="<%= s %>" <%= product.status === s ? 'selected' : '' %>><%= s %></option>
            <% }); %>
          </select>
        </label>

        <label class="field">
          <span>Purchase date</span>
          <input type="date" name="purchaseDate"
                 value="<%= product.purchaseDate ? new Date(product.purchaseDate).toISOString().slice(0, 10) : '' %>" />
        </label>

        <label class="field">
          <span>Price</span>
          <input type="number" name="price" min="0" step="0.01" value="<%= product.price || 0 %>" />
        </label>

        <label class="field full">
          <span>Assign to</span>
          <select name="assignedTo">
            <option value="">In store — nobody is holding it</option>
            <% users.forEach(function (u) { %>
              <option value="<%= u._id %>" <%= String(product.assignedTo) === String(u._id) ? 'selected' : '' %>>
                <%= u.name %> · <%= u.department %>
              </option>
            <% }); %>
          </select>
          <span class="help">
            Handing an item over here writes the same usage-log entry the bot would,
            so the monthly report stays complete.
          </span>
        </label>

        <label class="field full">
          <span>Reason, if handing it to someone</span>
          <input type="text" name="reason" maxlength="120" placeholder="What is it being taken for?" />
        </label>

        <label class="field full">
          <span>Image URL</span>
          <input type="url" name="imageUrl" id="imageUrl" value="<%= product.imageUrl || '' %>"
                 placeholder="https://…" />
        </label>

        <div class="field full">
          <span>Preview</span>
          <div class="preview-box" id="imagePreview"><span class="preview-empty">No image yet</span></div>
        </div>

        <label class="field full">
          <span>Notes</span>
          <textarea name="notes" rows="3"><%= product.notes || '' %></textarea>
        </label>
      </div>

      <div class="form-actions">
        <button class="btn btn-primary" type="submit"><%= isEdit ? 'Save changes' : 'Add item' %></button>
        <a class="btn btn-ghost" href="/admin/products">Cancel</a>
      </div>
    </form>
  </div>
</section>
