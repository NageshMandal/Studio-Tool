
<section class="stat-grid">
  <div class="stat tone-blue">
    <div class="stat-head">
      <div><span class="stat-label">Taken out</span><div class="stat-value"><%= summary.startedToday %></div></div>
      <span class="stat-ico"><%- icon('box', 18) %></span>
    </div>
  </div>
  <div class="stat tone-green">
    <div class="stat-head">
      <div><span class="stat-label">Returned</span><div class="stat-value"><%= summary.returnedToday %></div></div>
      <span class="stat-ico"><%- icon('check', 18) %></span>
    </div>
  </div>
  <div class="stat tone-amber">
    <div class="stat-head">
      <div><span class="stat-label">Still out</span><div class="stat-value"><%= summary.stillOut %></div></div>
      <span class="stat-ico"><%- icon('clock', 18) %></span>
    </div>
  </div>
  <div class="stat">
    <div class="stat-head">
      <div><span class="stat-label">Hours logged</span><div class="stat-value"><%= summary.totalHours %></div></div>
      <span class="stat-ico" style="background: var(--purple-soft); color: var(--purple)"><%- icon('log', 18) %></span>
    </div>
    <% if (summary.busiest) { %>
      <p class="stat-note">Busiest: <%= summary.busiest.name %> (<%= summary.busiest.count %>)</p>
    <% } %>
  </div>
</section>

<section class="panel">
  <div class="panel-head">
    <div>
      <h2>Usage log</h2>
      <p class="sub"><%= formatDate(date) %><%= isToday ? ' · today' : '' %> at <%= activeStudio.name %></p>
    </div>
    <div class="month-nav">
      <a class="btn btn-ghost btn-sm" href="/admin/logs?date=<%= prevDate %>">‹</a>
      <span class="current"><%= formatDate(date) %></span>
      <a class="btn btn-ghost btn-sm" href="/admin/logs?date=<%= nextDate %>">›</a>
    </div>
  </div>

  <form class="filters" method="GET" action="/admin/logs">
    <input type="hidden" name="date" value="<%= date %>" />
    <label class="field">
      <span>Search</span>
      <input type="search" name="q" value="<%= query.q %>" placeholder="Item, tag or person" />
    </label>
    <label class="field">
      <span>Staff</span>
      <select name="staff">
        <option value="">All staff</option>
        <% staffList.forEach(function (u) { %>
          <option value="<%= u._id %>" <%= query.staff === String(u._id) ? 'selected' : '' %>><%= u.name %></option>
        <% }); %>
      </select>
    </label>
    <div class="actions">
      <button class="btn btn-primary" type="submit">Filter</button>
      <a class="btn btn-ghost" href="/admin/logs?date=<%= date %>">Reset</a>
    </div>
  </form>

  <% if (logs.length === 0) { %>
    <div class="empty">
      <h3>Nothing logged</h3>
      <p>No equipment moved on this day.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th></th><th>Asset tag</th><th>Item</th><th>Person</th><th>Taken</th><th>Returned</th><th>Held</th><th>Reason</th></tr>
        </thead>
        <tbody>
          <% logs.forEach(function (l) { %>
            <tr>
              <td class="thumb-cell">
                <%- include('../partials/thumb', { thumbUrl: l.imageUrl, thumbName: l.productName }) %>
              </td>
              <td><span class="asset-tag"><%= l.assetTag %></span></td>
              <td><span class="row-title"><%= l.productName %></span></td>
              <td><%= l.userName %></td>
              <td><%= formatWhen(l.occupiedAt) %></td>
              <td>
                <% if (l.returnedAt) { %><%= formatWhen(l.returnedAt) %>
                <% } else { %><span class="badge badge-amber">Still out</span><% } %>
              </td>
              <td><%= l.durationMinutes != null ? formatDuration(l.durationMinutes) : formatSince(l.occupiedAt) %></td>
              <td><%= l.reason || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
