
<section class="stat-grid">
  <div class="stat tone-blue">
    <div class="stat-head">
      <div><span class="stat-label">Taken out</span><div class="stat-value"><%= summary.startedToday %></div></div>
      <span class="stat-ico"><%- icon('box', 18) %></span>
    </div>
  </div>
  <div class="stat tone-green">
    <div class="stat-head">
      <div><span class="stat-label">Returned</span><div class="stat-value"><%= summary.returnedToday %></div></div>
      <span class="stat-ico"><%- icon('check', 18) %></span>
    </div>
  </div>
  <div class="stat tone-amber">
    <div class="stat-head">
      <div><span class="stat-label">Occupied</span><div class="stat-value"><%= summary.stillOut %></div></div>
      <span class="stat-ico"><%- icon('clock', 18) %></span>
    </div>
  </div>
  <div class="stat">
    <div class="stat-head">
      <div><span class="stat-label">Hours logged</span><div class="stat-value"><%= summary.totalHours %></div></div>
      <span class="stat-ico" style="background: var(--purple-soft); color: var(--purple)"><%- icon('log', 18) %></span>
    </div>
    <% if (summary.busiest) { %>
      <p class="stat-note">Busiest: <%= summary.busiest.name %> (<%= summary.busiest.count %>)</p>
    <% } %>
  </div>
</section>

<section class="panel">
  <div class="panel-head">
    <div>
      <h2>Usage log</h2>
      <p class="sub"><%= range.label %><%= isToday ? ' · today' : '' %> at <%= activeStudio.name %></p>
    </div>
    <%
      /* The arrows step by the length of the range you are looking at: a day
         moves a day, a week moves a week. All time has nothing to step. */
    %>
    <% if (prevUrl) { %>
      <div class="month-nav">
        <a class="btn btn-ghost btn-sm" href="<%= prevUrl %>" title="Previous <%= range.days %> day(s)">‹</a>
        <span class="current"><%= range.label %></span>
        <a class="btn btn-ghost btn-sm" href="<%= nextUrl %>" title="Next <%= range.days %> day(s)">›</a>
      </div>
    <% } %>
  </div>

  <form class="filters" method="GET" action="/admin/logs">
    <%- include('../partials/date-range', { range: range, presets: ['today', 'yesterday', '7d', '30d', 'month'], maxDate: maxDate }) %>

    <label class="field">
      <span>Search</span>
      <input type="search" name="q" value="<%= query.q %>" placeholder="Item, tag or person" />
    </label>
    <label class="field">
      <span>Staff</span>
      <select name="staff">
        <option value="">All staff</option>
        <% staffList.forEach(function (u) { %>
          <option value="<%= u._id %>" <%= query.staff === String(u._id) ? 'selected' : '' %>><%= u.name %></option>
        <% }); %>
      </select>
    </label>
    <div class="actions">
      <button class="btn btn-primary" type="submit">Filter</button>
      <a class="btn btn-ghost" href="<%= resetUrl %>">Reset</a>
    </div>
  </form>

  <% if (logs.length === 0) { %>
    <div class="empty">
      <h3>Nothing logged</h3>
      <p>No equipment moved in <%= range.label.toLowerCase() === 'all time' ? 'any period on record' : range.label %>.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th></th><th>Asset tag</th><th>Item</th><th>Person</th><th>Taken</th><th>Submitted</th><th>Accepted</th><th>Held</th><th>Reason</th></tr>
        </thead>
        <tbody>
          <% logs.forEach(function (l) { %>
            <tr>
              <td class="thumb-cell">
                <%- include('../partials/thumb', { thumbUrl: l.imageUrl, thumbName: l.productName }) %>
              </td>
              <td><span class="asset-tag"><%= l.assetTag %></span></td>
              <td><span class="row-title"><%= l.productName %></span></td>
              <td><%= l.userName %></td>
              <td><%= formatWhen(l.occupiedAt) %></td>
              <%- include('../partials/return-cells', { log: l }) %>
              <td><%= l.durationMinutes != null ? formatDuration(l.durationMinutes) : formatSince(l.occupiedAt) %></td>
              <td><%= l.reason || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (truncated) { %>
      <p class="hint" style="padding: 12px 18px">
        Showing the most recent <%= rowLimit %> of <%= totalCount %> movements.
        Narrow the range, or export the CSV from Reports for the full list.
      </p>
    <% } %>
  <% } %>
</section>
