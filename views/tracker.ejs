
<section class="panel">
  <div class="panel-head">
    <div>
      <h2>Studio tracker</h2>
      <p class="sub">Every movement at <%= activeStudio.name %> · <%= range.label %></p>
    </div>
    <div class="btn-row">
      <% if (prevUrl) { %>
        <div class="month-nav">
          <a class="btn btn-ghost btn-sm" href="<%= prevUrl %>" title="Previous <%= range.days %> day(s)">‹</a>
          <a class="btn btn-ghost btn-sm" href="<%= nextUrl %>" title="Next <%= range.days %> day(s)">›</a>
        </div>
      <% } %>
      <a class="btn btn-primary btn-sm" href="/admin/products/new"><%- icon('plus', 15) %> Add new item</a>
    </div>
  </div>

  <form class="filters" method="GET" action="/admin/tracker">
    <%- include('partials/date-range', { range: range, presets: ['today', 'yesterday', '7d', '30d', 'month'], maxDate: maxDate }) %>

    <label class="field">
      <span>Staff</span>
      <select name="staff">
        <option value="">All staff</option>
        <% staffList.forEach(function (u) { %>
          <option value="<%= u._id %>" <%= query.staff === String(u._id) ? 'selected' : '' %>><%= u.name %></option>
        <% }); %>
      </select>
    </label>
    <label class="field">
      <span>Status</span>
      <select name="status">
        <option value="">All status</option>
        <option value="out" <%= query.status === 'out' ? 'selected' : '' %>>Still out</option>
        <option value="returned" <%= query.status === 'returned' ? 'selected' : '' %>>Returned</option>
      </select>
    </label>
    <div class="actions">
      <button class="btn btn-primary" type="submit">Filter</button>
      <a class="btn btn-ghost" href="/admin/tracker">Reset</a>
    </div>
  </form>

  <% if (rows.length === 0) { %>
    <div class="empty">
      <h3>Nothing in <%= range.label %></h3>
      <p>No equipment movements matched those filters.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Date</th><th>Item</th><th>Assigned to</th><th>Reason</th><th>Duration</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% rows.forEach(function (r) { %>
            <tr>
              <td><%= formatWhen(r.occupiedAt) %></td>
              <td>
                <span class="row-title"><%= r.productName %></span>
                <span class="row-sub"><%= r.assetTag %></span>
              </td>
              <td>
                <span class="person">
                  <span class="avatar"><%= (r.userName || '?').trim().charAt(0).toUpperCase() %></span>
                  <%= r.userName %>
                </span>
              </td>
              <td><%= r.reason || '—' %></td>
              <td><%= r.durationMinutes != null ? formatDuration(r.durationMinutes) : formatSince(r.occupiedAt) %></td>
              <td>
                <% if (r.returnedAt) { %>
                  <span class="badge badge-green">Completed</span>
                <% } else { %>
                  <span class="badge badge-amber">In progress</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (truncated) { %>
      <p class="hint" style="padding: 12px 18px">
        Showing the most recent <%= rowLimit %> of <%= totalCount %> movements.
        Narrow the range to see the rest.
      </p>
    <% } %>
  <% } %>
</section>
