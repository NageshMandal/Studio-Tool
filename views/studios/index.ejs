<%
  /**
   * The one studio screen: pick a studio, add one, or edit one — all here.
   *
   * Each card carries a small line drawing so the studios are told apart at a
   * glance rather than by reading. A studio's `theme` picks both the drawing
   * and the accent colour, and `landmark()` falls back to a generic studio
   * building for any studio added later — this must keep working for a fourth
   * and fifth city, not just the first three.
   */
  function landmark(theme) {
    var art = {
      green:
        '<path d="M60 96V60"/><path d="M100 96V60"/><ellipse cx="80" cy="40" rx="20" ry="22"/>' +
        '<path d="M80 18V8"/><path d="M52 60h56"/><path d="M40 96h80"/><path d="M30 96h100v8H30Z"/>' +
        '<path d="M46 96V66"/><path d="M114 96V66"/><path d="M66 96V74h28v22"/>',
      blue:
        '<path d="M80 8v14"/><path d="M64 96V38h32v58"/><path d="M64 38 80 22l16 16"/>' +
        '<path d="M40 96V56h24"/><path d="M96 96V56h24"/><path d="M28 96h104v8H28Z"/>' +
        '<path d="M74 96V76h12v20"/><path d="M48 84h8"/><path d="M104 84h8"/>',
      purple:
        '<path d="M20 78h120"/><path d="M46 78V30"/><path d="M114 78V30"/>' +
        '<path d="M46 30c22 18 46 18 68 0"/><path d="M20 60c14-14 26-14 26-14"/>' +
        '<path d="M140 60c-14-14-26-14-26-14"/><path d="M62 78V50"/><path d="M80 78V44"/>' +
        '<path d="M98 78V50"/><path d="M20 96h120v8H20Z"/>'
    };
    return art[theme] || (
      '<rect x="44" y="40" width="72" height="56" rx="3"/><path d="M44 40 80 16l36 24"/>' +
      '<path d="M66 96V70h28v26"/><path d="M56 54h12"/><path d="M92 54h12"/>' +
      '<path d="M30 96h100v8H30Z"/>'
    );
  }

  var live     = studios.filter(function (s) { return s.status === 'active'; });
  var archived = studios.filter(function (s) { return s.status !== 'active'; });
  var manage   = can.manageStudios;
%>

<div class="<%= bare ? 'select-wrap' : '' %>">

  <% if (bare) { %>
    <div class="select-head">
      <h1>Your studios</h1>
      <p>
        <% if (manage) { %>
          Open one to work in it, or add and edit them right here
        <% } else { %>
          You have access to the studio below
        <% } %>
      </p>
    </div>
  <% } %>

  <% if (flash) { %>
    <div class="alert alert-info"><%= flash %></div>
  <% } %>

  <% if (live.length === 0 && archived.length === 0) { %>

    <div class="panel">
      <div class="empty">
        <h3>No studios yet</h3>
        <p>
          A studio is the container for everything else — its items, its staff
          and its own admin. Create the first one to get started.
        </p>
        <% if (manage) { %>
          <button class="btn btn-primary" type="button" data-studio-new>
            <%- icon('plus', 16) %> Add the first studio
          </button>
        <% } else { %>
          <p class="hint">Ask the super admin to set up your studio.</p>
        <% } %>
      </div>
    </div>

  <% } else { %>

    <%
      /* The toolbar carries everything that used to be a separate page: the
         master view, the search, and the add button. */
    %>
    <div class="hub-bar">
      <div class="hub-bar-left">
        <span class="hub-count">
          <%= live.length %> active<%= archived.length ? ' · ' + archived.length + ' archived' : '' %>
        </span>
      </div>

      <div class="hub-bar-right">
        <% if (live.length > 5) { %>
          <div class="hub-search">
            <%- icon('search', 15) %>
            <input type="search" id="studioSearch" placeholder="Find a studio" autocomplete="off" />
          </div>
        <% } %>

        <% if (can.viewAllStudios) { %>
          <a class="btn btn-ghost btn-sm" href="/admin/studios/all">
            <%- icon('globe', 15) %> All studios at once
          </a>
        <% } %>

        <% if (manage) { %>
          <button class="btn btn-primary btn-sm" type="button" data-studio-new>
            <%- icon('plus', 15) %> Add studio
          </button>
        <% } %>
      </div>
    </div>

    <div class="studio-grid" id="studioGrid">
      <% live.forEach(function (s) { %>
        <%
          // The card for the studio you are already inside says so, rather
          // than leaving you to work it out from the sidebar
          var isCurrent = activeStudio && String(activeStudio._id) === String(s._id);
        %>
        <div class="studio-card theme-<%= s.theme %><%= isCurrent ? ' is-current' : '' %>"
             data-studio-search="<%= (s.name + ' ' + s.code + ' ' + (s.city || '')).toLowerCase() %>">
          <% if (isCurrent) { %>
            <span class="studio-card-flag">Open now</span>
          <% } %>

          <div class="art">
            <svg viewBox="0 0 160 112" width="180" height="118" fill="none"
                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <%- landmark(s.theme) %>
            </svg>
          </div>

          <h3><%= s.name %></h3>
          <p class="sub">
            <span class="asset-tag"><%= s.code %></span>
            <%= s.city || 'Studio' %>
          </p>

          <div class="facts">
            <div><b><%= s.itemCount %></b> items</div>
            <div><b><%= s.staffCount %></b> staff</div>
            <% if (manage) { %>
              <div><b><%= s.adminCount %></b> admins</div>
            <% } %>
          </div>

          <a class="btn btn-accent btn-block" href="/admin/studios/open/<%= s._id %>">
            <%= isCurrent ? 'Back to its dashboard' : 'Open dashboard' %> <%- icon('arrow', 16) %>
          </a>

          <% if (manage) { %>
            <div class="studio-card-tools">
              <button class="btn btn-ghost btn-sm" type="button"
                      data-studio-edit
                      data-id="<%= s._id %>"
                      data-name="<%= s.name %>"
                      data-code="<%= s.code %>"
                      data-city="<%= s.city || '' %>"
                      data-address="<%= s.address || '' %>"
                      data-phone="<%= s.phone || '' %>"
                      data-theme="<%= s.theme %>">
                <%- icon('edit', 14) %> Edit
              </button>

              <form method="POST" action="/admin/studios/<%= s._id %>/status?_method=PATCH"
                    data-confirm="Archive <%= s.name %>? Its records are kept, but its admins are deactivated and nobody can sign in to it.">
                <button class="btn btn-ghost btn-sm btn-quiet" type="submit">
                  <%- icon('archive', 14) %> Archive
                </button>
              </form>
            </div>
          <% } %>
        </div>
      <% }); %>

      <% if (manage) { %>
        <button class="studio-card studio-card-add" type="button" data-studio-new>
          <span class="plus"><%- icon('plus', 26) %></span>
          <span class="label">Add a studio</span>
          <span class="hint">A new location with its own items, staff and admin</span>
        </button>
      <% } %>
    </div>

    <p class="hub-empty-search" id="studioSearchEmpty" hidden>No studio matches that.</p>

    <% if (manage && archived.length) { %>
      <details class="hub-archived">
        <summary>
          <%- icon('archive', 15) %>
          Archived studios (<%= archived.length %>)
        </summary>

        <div class="table-wrap" style="margin-top: 12px">
          <table class="table">
            <thead>
              <tr><th>Studio</th><th>Code</th><th>City</th><th>Items</th><th>Staff</th><th></th></tr>
            </thead>
            <tbody>
              <% archived.forEach(function (s) { %>
                <tr>
                  <td>
                    <span class="row-title"><%= s.name %></span>
                    <span class="row-sub"><%= s.address || 'No address on file' %></span>
                  </td>
                  <td><span class="asset-tag"><%= s.code %></span></td>
                  <td><%= s.city || '—' %></td>
                  <td><%= s.itemCount %></td>
                  <td><%= s.staffCount %></td>
                  <td>
                    <form method="POST" action="/admin/studios/<%= s._id %>/status?_method=PATCH"
                          data-confirm="Restore <%= s.name %>? You will need to reactivate its admins separately.">
                      <button class="btn btn-ok btn-sm" type="submit">Restore</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <p class="hint" style="margin-top: 10px">
          Archiving closes the doors — its admins are deactivated and nobody can
          sign in — but every item, person and log row stays exactly where it
          is, so the decision is always reversible.
        </p>
      </details>
    <% } %>

  <% } %>
</div>

<% if (manage) { %>
  <%
    /**
     * The add/edit dialog. It is one form, not two: the only difference is
     * where it posts and whether the code is editable, so keeping it single
     * means the two paths can never drift apart. It ships closed and JS opens
     * it — except when a rejected save sends us back with the values still in
     * hand, in which case it is open on arrival and needs no JS at all.
     */
    var open      = Boolean(form);
    var isEdit    = open && form.mode === 'edit';
    var s         = open ? form.studio : {};
    var formError = open ? form.error : null;
  %>

  <div class="modal-backdrop<%= open ? ' is-open' : '' %>" id="studioModal" role="dialog" aria-modal="true" aria-labelledby="studioModalTitle">
    <div class="modal">
      <div class="modal-head">
        <div>
          <h2 id="studioModalTitle"><%= isEdit ? 'Edit studio' : 'New studio' %></h2>
          <p class="sub" id="studioModalSub">
            <%= isEdit
              ? 'The code cannot change — it is already printed on this studio\u2019s asset tags'
              : 'The code becomes the prefix on every asset tag at this studio' %>
          </p>
        </div>
        <button class="modal-close" type="button" data-studio-close aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>

      <div class="modal-body">
        <div class="alert alert-error" id="studioModalError" <%= formError ? '' : 'hidden' %>>
          <%= formError || '' %>
        </div>

        <form method="POST" id="studioForm" novalidate
              action="<%= isEdit ? '/admin/studios/' + s._id + '?_method=PUT' : '/admin/studios' %>">
          <div class="form-grid">
            <label class="field">
              <span>Studio name</span>
              <input type="text" name="name" id="studioName" value="<%= s.name || '' %>"
                     placeholder="Patna" required />
            </label>

            <label class="field">
              <span>Code</span>
              <input type="text" name="code" id="studioCode" value="<%= s.code || '' %>"
                     placeholder="PAT" maxlength="5" required
                     style="text-transform: uppercase" <%= isEdit ? 'disabled' : '' %> />
              <span class="help" id="studioCodeHelp">
                <%= isEdit
                  ? 'Fixed — every asset tag here already starts with it.'
                  : '2–5 letters. Tags become PAT-0001, PAT-0002 and so on.' %>
              </span>
            </label>

            <label class="field">
              <span>City</span>
              <input type="text" name="city" id="studioCity" value="<%= s.city || '' %>" placeholder="Patna" />
            </label>

            <label class="field">
              <span>Phone</span>
              <input type="text" name="phone" id="studioPhone" value="<%= s.phone || '' %>"
                     placeholder="Reception number" />
            </label>

            <label class="field full">
              <span>Address</span>
              <input type="text" name="address" id="studioAddress" value="<%= s.address || '' %>"
                     placeholder="Street, area, pin code" />
            </label>

            <label class="field full">
              <span>Accent colour</span>
              <select name="theme" id="studioTheme">
                <% themes.forEach(function (t) { %>
                  <option value="<%= t %>" <%= s.theme === t ? 'selected' : '' %>>
                    <%= t.charAt(0).toUpperCase() + t.slice(1) %>
                  </option>
                <% }); %>
              </select>
              <span class="help">Used on this studio's card, badges and dashboard so it is recognisable at a glance.</span>
            </label>
          </div>

          <p class="hint" id="studioNewNote" <%= isEdit ? 'hidden' : '' %>>
            A new studio starts empty. Add its <b>location admin</b> from Admin
            accounts next — they will be the only person who can run it.
          </p>

          <div class="form-actions">
            <button class="btn btn-primary" type="submit" id="studioSubmit">
              <%= isEdit ? 'Save changes' : 'Create studio' %>
            </button>
            <button class="btn btn-ghost" type="button" data-studio-close>Cancel</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>
