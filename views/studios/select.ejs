<%
  /**
   * Each studio card carries a small line drawing so the three are told
   * apart at a glance rather than by reading. A studio's `theme` picks both
   * the drawing and the accent colour, and `landmark()` falls back to a
   * generic studio building for any studio the super admin adds later — the
   * screen must keep working for a fourth and fifth city, not just these.
   */
  function landmark(theme) {
    var art = {
      green:
        '<path d="M60 96V60"/><path d="M100 96V60"/><ellipse cx="80" cy="40" rx="20" ry="22"/>' +
        '<path d="M80 18V8"/><path d="M52 60h56"/><path d="M40 96h80"/><path d="M30 96h100v8H30Z"/>' +
        '<path d="M46 96V66"/><path d="M114 96V66"/><path d="M66 96V74h28v22"/>',
      blue:
        '<path d="M80 8v14"/><path d="M64 96V38h32v58"/><path d="M64 38 80 22l16 16"/>' +
        '<path d="M40 96V56h24"/><path d="M96 96V56h24"/><path d="M28 96h104v8H28Z"/>' +
        '<path d="M74 96V76h12v20"/><path d="M48 84h8"/><path d="M104 84h8"/>',
      purple:
        '<path d="M20 78h120"/><path d="M46 78V30"/><path d="M114 78V30"/>' +
        '<path d="M46 30c22 18 46 18 68 0"/><path d="M20 60c14-14 26-14 26-14"/>' +
        '<path d="M140 60c-14-14-26-14-26-14"/><path d="M62 78V50"/><path d="M80 78V44"/>' +
        '<path d="M98 78V50"/><path d="M20 96h120v8H20Z"/>'
    };
    return art[theme] || (
      '<rect x="44" y="40" width="72" height="56" rx="3"/><path d="M44 40 80 16l36 24"/>' +
      '<path d="M66 96V70h28v26"/><path d="M56 54h12"/><path d="M92 54h12"/>' +
      '<path d="M30 96h100v8H30Z"/>'
    );
  }
%>

<div class="select-wrap">
  <div class="select-head">
    <h1>Select your studio</h1>
    <p>
      <% if (can.isSuper) { %>
        Choose the location you want to open, or see all of them together
      <% } else { %>
        You have access to the studio below
      <% } %>
    </p>
  </div>

  <% if (message) { %>
    <div class="alert alert-info" style="max-width: 620px; margin: 0 auto 26px"><%= message %></div>
  <% } %>

  <% if (studios.length === 0) { %>
    <div class="panel">
      <div class="empty">
        <h3>No studios yet</h3>
        <p>
          A studio is the container for everything else — its items, its staff and
          its own admin. Create the first one to get started.
        </p>
        <% if (can.manageStudios) { %>
          <a class="btn btn-primary" href="/admin/studios/new"><%- icon('plus', 16) %> Add the first studio</a>
        <% } else { %>
          <p class="hint">Ask the super admin to set up your studio.</p>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <div class="studio-grid">
      <% studios.forEach(function (s) { %>
        <div class="studio-card theme-<%= s.theme %>">
          <div class="art">
            <svg viewBox="0 0 160 112" width="180" height="118" fill="none"
                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <%- landmark(s.theme) %>
            </svg>
          </div>

          <h3><%= s.name %></h3>
          <p class="sub"><%= s.city || s.name %> Studio</p>

          <div class="facts">
            <div><b><%= s.itemCount %></b> items</div>
            <div><b><%= s.staffCount %></b> staff</div>
          </div>

          <a class="btn btn-accent btn-block" href="/admin/studios/open/<%= s._id %>">
            Open dashboard <%- icon('arrow', 16) %>
          </a>
        </div>
      <% }); %>
    </div>

    <% if (can.viewAllStudios) { %>
      <div class="btn-row" style="justify-content: center; margin-top: 30px">
        <a class="btn btn-ghost" href="/admin/studios/all">
          <%- icon('globe', 16) %> Master dashboard — all studios at once
        </a>
        <% if (can.manageStudios) { %>
          <a class="btn btn-ghost" href="/admin/studios/manage">
            <%- icon('building', 16) %> Manage studios
          </a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>
