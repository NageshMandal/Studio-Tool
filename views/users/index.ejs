
<section class="panel">
  <div class="panel-head">
    <div>
      <h2>Staff at <%= activeStudio.name %></h2>
      <p class="sub">They sign in to the staff portal and the Telegram bot with these details</p>
    </div>
    <a class="btn btn-primary" href="/admin/users/new"><%- icon('plus', 15) %> Add staff member</a>
  </div>

  <form class="filters" method="GET" action="/admin/users">
    <label class="field">
      <span>Search</span>
      <input type="search" name="q" value="<%= query.q %>" placeholder="Name, email or employee ID" />
    </label>
    <label class="field">
      <span>Department</span>
      <select name="department">
        <option value="">All departments</option>
        <% departments.forEach(function (d) { %>
          <option value="<%= d %>" <%= query.department === d ? 'selected' : '' %>><%= d %></option>
        <% }); %>
      </select>
    </label>
    <label class="field">
      <span>Role</span>
      <select name="staffRole">
        <option value="">All roles</option>
        <% staffRoles.forEach(function (r) { %>
          <option value="<%= r %>" <%= query.staffRole === r ? 'selected' : '' %>><%= r %></option>
        <% }); %>
      </select>
    </label>
    <label class="field">
      <span>Status</span>
      <select name="status">
        <option value="">All</option>
        <option value="active" <%= query.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= query.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </label>
    <div class="actions">
      <button class="btn btn-primary" type="submit">Filter</button>
      <a class="btn btn-ghost" href="/admin/users">Reset</a>
    </div>
  </form>

  <% if (users.length === 0) { %>
    <div class="empty">
      <h3>Nobody here yet</h3>
      <p>Add the people who work at <%= activeStudio.name %> so they can book and take out equipment.</p>
      <a class="btn btn-primary" href="/admin/users/new">Add the first person</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Name</th><th>Email</th><th>Department</th><th>Account</th><th>Holding</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% users.forEach(function (u) { %>
            <tr>
              <td>
                <span class="person">
                  <span class="avatar"><%= u.name.trim().charAt(0).toUpperCase() %></span>
                  <span>
                    <span class="row-title"><%= u.name %></span>
                    <span class="row-sub">
                      <%= u.designation || u.employeeId || '—' %>
                      <% if (u.staffRole === 'sales') { %>
                        <span class="role-pill role-sales">Sales</span>
                      <% } %>
                    </span>
                  </span>
                </span>
              </td>
              <td>
                <%= u.email %>
                <% if (u.telegramChatId) { %>
                  <span class="badge badge-blue" title="Signed in to the Telegram bot">bot</span>
                <% } %>
              </td>
              <td><%= u.department %></td>
              <td>
                <span class="badge <%= u.accountType === 'power' ? 'badge-purple' : 'badge-grey' %>">
                  <%= u.accountType %>
                </span>
              </td>
              <td>
                <%= u.itemsHeld %>
                <% if (u.openPurchases > 0) { %>
                  <span class="badge badge-amber" title="Open purchase requests"><%= u.openPurchases %> asks</span>
                <% } %>
              </td>
              <td>
                <span class="badge <%= u.status === 'active' ? 'badge-green' : 'badge-grey' %>"><%= u.status %></span>
              </td>
              <td>
                <div class="btn-row">
                  <a class="btn btn-ghost btn-sm" href="/admin/users/<%= u._id %>/edit">Edit</a>

                  <form method="POST" action="/admin/users/<%= u._id %>/status?_method=PATCH">
                    <button class="btn btn-ghost btn-sm" type="submit">
                      <%= u.status === 'active' ? 'Deactivate' : 'Activate' %>
                    </button>
                  </form>

                  <% if (can.deletePeople) { %>
                    <form method="POST" action="/admin/users/<%= u._id %>?_method=DELETE"
                          onsubmit="return confirm('Remove <%= u.name %>? Anything they are holding is returned first.')">
                      <button class="btn btn-danger btn-sm" type="submit">Remove</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<div class="alert alert-info">
  <b>Power vs normal.</b> A <b>power</b> account can take an available item
  straight off the shelf. A <b>normal</b> account can only ask, and an admin here
  approves it. Both can raise purchase requests for items the studio does not own.
</div>
