<%
  // The same availability rules the server enforces, mirrored here so a
  // button is never offered for something the action would refuse.
  function blocked(p) {
    return (
      p.condition === 'retired' ||
      p.status === 'maintenance' ||
      p.status === 'pending-return' ||
      p.condition === 'needs-repair'
    );
  }
%>

<section class="panel">
  <div class="panel-head">
    <div>
      <h2>Equipment at <%= user.location.name %></h2>
      <p class="sub">
        <% if (user.accountType === 'power') { %>
          You can take an available item straight out
        <% } else { %>
          Ask for an item and your studio admin will approve it
        <% } %>
      </p>
    </div>
    <a class="btn btn-ghost btn-sm" href="/staff/purchase-requests">
      <%- icon('cart', 15) %> Not here? Request it
    </a>
  </div>

  <form class="filters" method="GET" action="/staff/inventory">
    <label class="field">
      <span>Search</span>
      <input type="search" name="q" value="<%= query.q %>" placeholder="Name, tag or brand" />
    </label>
    <label class="field">
      <span>Category</span>
      <select name="category">
        <option value="">All categories</option>
        <% categories.forEach(function (c) { %>
          <option value="<%= c %>" <%= query.category === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </label>
    <label class="field">
      <span>Status</span>
      <select name="status">
        <option value="">All status</option>
        <% statuses.forEach(function (s) { %>
          <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
    </label>
    <div class="actions">
      <button class="btn btn-primary" type="submit">Filter</button>
      <a class="btn btn-ghost" href="/staff/inventory">Reset</a>
    </div>
  </form>
</section>

<%
  /**
   * Asking for several items at once.
   *
   * The form lives here, on its own, while its checkboxes sit inside the
   * item cards further down. They are tied together by the HTML `form`
   * attribute rather than by nesting, because each card already contains its
   * own form and forms cannot be nested — doing it the obvious way would
   * produce markup browsers quietly rearrange.
   */
%>
<form method="POST" action="/staff/requests" id="bulkRequest" class="panel bulk-bar" hidden>
  <div class="bulk-count">
    <b id="bulkCount">0</b> selected
  </div>
  <label class="field">
    <span>What are they for?</span>
    <input type="text" name="reason" maxlength="120" required
           placeholder="One reason for all of them" />
  </label>
  <div class="actions">
    <button class="btn btn-primary" type="submit">
      <%= user.accountType === 'power' ? 'Take selected' : 'Ask for selected' %>
    </button>
    <button class="btn btn-ghost" type="button" id="bulkClear">Clear</button>
  </div>
  <p class="hint bulk-note">
    <% if (user.accountType === 'power') { %>
      Anything unavailable is skipped and named, rather than failing the lot.
    <% } else { %>
      Your admin can approve them all at once, or approve some and decline others.
    <% } %>
  </p>
</form>

<% if (groups.length === 0) { %>
  <div class="panel">
    <div class="empty">
      <h3>Nothing matches</h3>
      <p>
        No equipment here fits those filters. If your studio simply does not own
        what you need, you can ask for it.
      </p>
      <a class="btn btn-primary" href="/staff/purchase-requests">Request an item</a>
    </div>
  </div>
<% } %>

<% groups.forEach(function (g) { %>
  <p class="category-head"><%= g.category %></p>
  <div class="item-grid">
    <% g.items.forEach(function (p) { %>
      <%
        var mine = p.assignedTo && String(p.assignedTo) === String(user._id);
        var pending = pendingByProduct[String(p._id)];
        var claim = claimByProduct[String(p._id)];
        var booked = bookedTodayByProduct[String(p._id)];
      %>
      <%
        // Selectable only when asking for it would actually succeed — the
        // same test the server applies, so a tick is never a false promise
        var selectable = !mine && !pending && !p.assignedTo && !blocked(p) &&
          !(booked && String(booked.user) !== String(user._id));
      %>
      <div class="item-card">
        <div class="top">
          <% if (selectable) { %>
            <input class="bulk-tick" type="checkbox" name="items" value="<%= p._id %>"
                   form="bulkRequest" aria-label="Select <%= p.name %>" />
          <% } %>
          <%- include('../partials/thumb', { thumbUrl: p.imageUrl, thumbName: p.name }) %>
          <div style="min-width: 0">
            <h4><%= p.name %></h4>
            <span class="row-sub"><%= p.assetTag %> · <%= p.brand || '' %></span>
          </div>
        </div>

        <div>
          <% if (mine) { %>
            <span class="badge badge-blue">With you</span>
          <% } else if (p.assignedTo) { %>
            <span class="badge badge-amber">With <%= holderMap[String(p.assignedTo)] || 'someone' %></span>
          <% } else if (blocked(p)) { %>
            <span class="badge badge-red">Unavailable</span>
          <% } else if (booked && String(booked.user) !== String(user._id)) { %>
            <span class="badge badge-purple">Booked today by <%= booked.userName %></span>
          <% } else { %>
            <span class="badge badge-green">Available</span>
          <% } %>
          <% if (claim) { %>
            <span class="badge badge-grey"><%= claim.userName %> next</span>
          <% } %>
        </div>

        <% if (mine) { %>
          <form method="POST" action="/staff/return/<%= p._id %>" class="submit-form">
            <label class="field">
              <span>How is it coming back?</span>
              <input type="text" name="remark" maxlength="300" required
                     placeholder="Type NA if nothing happened" />
              <span class="help">
                Say if anything happened to it. Your admin adds their own note
                when they check it in, so both accounts are kept.
              </span>
            </label>
            <button class="btn btn-primary btn-block btn-sm" type="submit">Submit item</button>
          </form>

        <% } else if (pending) { %>
          <form method="POST" action="/staff/requests/<%= pending._id %>/cancel">
            <p class="hint">Waiting for the admin to decide.</p>
            <button class="btn btn-ghost btn-sm btn-block" type="submit">Cancel my request</button>
          </form>

        <% } else if (!p.assignedTo && !blocked(p)) { %>
          <form method="POST" action="/staff/occupy/<%= p._id %>" class="inline-form">
            <input type="text" name="reason" placeholder="What is it for?" maxlength="120" required />
            <button class="btn btn-primary btn-sm" type="submit">
              <%= user.accountType === 'power' ? 'Take' : 'Ask' %>
            </button>
          </form>

        <% } else if (p.assignedTo && user.accountType === 'power' && !claim) { %>
          <form method="POST" action="/staff/claim/<%= p._id %>" class="inline-form">
            <input type="text" name="reason" placeholder="Why you need it next" maxlength="120" required />
            <button class="btn btn-ghost btn-sm" type="submit">I'm next</button>
          </form>
        <% } %>

        <details>
          <summary class="hint" style="cursor: pointer">Book for a date</summary>
          <form method="POST" action="/staff/book/<%= p._id %>" style="margin-top: 9px">
            <label class="field" style="margin-bottom: 8px">
              <span>Pickup</span>
              <input type="date" name="date" min="<%= todayKey %>" required />
              <input type="time" name="pickupTime" required style="margin-top: 6px" />
            </label>
            <label class="field" style="margin-bottom: 8px">
              <span>Drop off</span>
              <input type="date" name="dropDate" min="<%= todayKey %>" required />
              <input type="time" name="dropTime" required style="margin-top: 6px" />
            </label>
            <label class="field" style="margin-bottom: 8px">
              <span>Reason</span>
              <input type="text" name="reason" maxlength="120" required />
            </label>
            <button class="btn btn-ghost btn-sm btn-block" type="submit">Request booking</button>
          </form>
        </details>
      </div>
    <% }); %>
  </div>
<% }); %>
