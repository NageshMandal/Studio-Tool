<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Studio Tracker</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="shell">
    <%- include('../partials/staff-sidebar') %>

    <main class="main">
      <header class="topbar">
        <div class="topbar-title">
          <div>
            <h1 class="page-title"><%= title %></h1>
            <p class="page-sub"><%= studio.name %> studio</p>
          </div>
        </div>
        <div class="topbar-right">
          <div class="whoami">
            <span class="avatar"><%= staff.name.trim().charAt(0).toUpperCase() %></span>
            <span>
              <span class="whoami-name"><%= staff.name %></span>
              <span class="whoami-role"><%= staff.accountType %> account</span>
            </span>
          </div>
          <form method="POST" action="/staff/logout">
            <button class="btn btn-ghost btn-sm" type="submit">Log out</button>
          </form>
        </div>
      </header>

      <div class="content">
        <% if (typeof message !== 'undefined' && message) { %>
          <div class="alert alert-info"><%= message %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>
        <%- body %>
      </div>
    </main>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>
