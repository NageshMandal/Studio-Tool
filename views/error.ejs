<div class="auth-card error-card">
  <div class="auth-form">
    <p class="eyebrow">Error <%= code %></p>
    <h1><%= code === 404 ? 'Not found' : 'Server error' %></h1>
    <p class="hint"><%= message %></p>
    <a class="btn btn-primary" href="/admin/dashboard">Back to dashboard</a>
  </div>
</div>
