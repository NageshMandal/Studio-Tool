# Copy this file to .env and fill in your own values

PORT=3000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/office_inventory

# Admin login (this is the only account that can sign in)
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@office.com
ADMIN_PASSWORD=Admin@12345

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
COOKIE_EXPIRES_DAYS=1

# Telegram bot (leave TELEGRAM_BOT_TOKEN blank to run the panel without the bot)
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TIMEZONE=Asia/Kolkata
