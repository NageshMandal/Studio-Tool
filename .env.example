# Copy this file to .env and fill in your own values

PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# DATABASE
#
# The variable must be named MONGO_URI exactly (not MONGODB_URI).
# Do not wrap the value in quotes.
#
# Local:  mongodb://127.0.0.1:27017/studio_tracker
# Atlas:  mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/studio_tracker?retryWrites=true&w=majority
#
# If the password contains @ : / ? # [ ] or %, percent-encode it:
#   @ -> %40    # -> %23    / -> %2F    : -> %3A
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/studio_tracker

# ---------------------------------------------------------------------------
# Only needed if you hit: querySrv ECONNREFUSED _mongodb._tcp.<cluster>
#
# That error means the DNS resolver Node uses refused the SRV lookup for your
# Atlas cluster — Atlas itself is never contacted, so it is not a password or
# IP-allow-list problem. Note that `nslookup` succeeding does NOT rule it out:
# Node uses its own resolver, not the one nslookup uses.
#
# Uncommenting this points Node at public DNS for this app only; nothing else
# on your machine changes.
#
# DNS_SERVERS=8.8.8.8,1.1.1.1
#
# Alternative: use the non-SRV connection string instead, which skips the DNS
# SRV lookup entirely. In Atlas: Connect -> Drivers -> "Node.js 2.2.12 or
# earlier". Works on networks and VPNs that block SRV queries.
#
# Set DEBUG_DB=1 to print full stack traces on connection failure.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# THE SUPER ADMIN
#
# This account lives here and only here. It is the top of the hierarchy:
# it creates studios, appoints one location admin per studio, and can open
# every studio's dashboard plus the master view across all of them.
#
# It has no database row, so it cannot be edited, deactivated or deleted from
# the panel — change it here and restart. It is also, deliberately, the one
# account that CANNOT see staff purchase requests: those belong to each
# studio's own admin.
# ---------------------------------------------------------------------------
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@office.com
ADMIN_PASSWORD=Admin@12345

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
COOKIE_EXPIRES_DAYS=1

# Telegram bot (leave TELEGRAM_BOT_TOKEN blank to run the panel without the bot)
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TIMEZONE=Asia/Kolkata

# Optional: the super admin's own Telegram chat id. Studio traffic does NOT
# go here — each studio's requests go to that studio's own admins only.
ADMIN_TELEGRAM_CHAT_ID=
